        { "value": "house_villa", "label": "House / Villa", "icon": "home-outline", "values": ["independent_house", "villa"], "aliases": ["Villa", "Independent House"] },
        { "value": "builder_floor", "label": "Builder floor", "icon": "layers-outline", "aliases": ["Builder Floor"] },
        { "value": "penthouse", "label": "Penthouse", "icon": "diamond-outline", "aliases": ["Penthouse"] }
      ]
