{
  "version": 2,
  "definitions": {
    "budget": {
      "label": "Budget range",
      "type": "range",
      "queryKeys": ["minPrice", "maxPrice"],
      "format": "inr",
      "steps": [500000, 1000000, 2000000, 3000000, 4000000, 5000000, 6000000, 7500000, 10000000, 15000000, 20000000, 30000000, 50000000, 100000000, 200000000]
    },
    "rentBudget": {
      "label": "Monthly rent",
      "type": "range",
      "queryKeys": ["minPrice", "maxPrice"],
      "format": "inr",
      "steps": [3000, 5000, 7500, 10000, 15000, 20000, 25000, 30000, 40000, 50000, 75000, 100000, 150000, 200000]
    },
    "propertyType": {
