# Copy to frontend/.env and set the address of YOUR backend (must end with /api). Restart Expo with: npx expo start -c
#
# Physical Android phone on the same Wi-Fi as your PC:  http://<PC_LAN_IP>:5000/api
# Android emulator:                                      http://10.0.2.2:5000/api
# USB cable (after: adb reverse tcp:5000 tcp:5000):      http://localhost:5000/api
# Production (EAS build / deployed backend):             https://your-backend.onrender.com/api
EXPO_PUBLIC_API_URL=http://192.168.68.199:5000/api
