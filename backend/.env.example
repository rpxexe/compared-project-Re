# Copy this file to backend/.env and fill in real values. NEVER commit backend/.env.

# --- Database (the ONLY place the MongoDB connection string lives) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/comparedb?retryWrites=true&w=majority
MONGODB_COLLECTION=properties
# Optional: non-SRV (mongodb://host1,host2,...) string for the SAME cluster, used only when
# your network's DNS cannot resolve mongodb+srv records. Leave empty if you don't need it.
MONGODB_FALLBACK_URI=

# --- Server ---
PORT=5000
NODE_ENV=development
# Random string, 24+ chars (required in production). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d
# Comma-separated origins allowed for browser clients (the mobile app does not need this). Empty = allow all.
CORS_ORIGINS=

# --- OTP ---
# development = OTP is printed in the server console and returned as devOtp (testing only)
# twilio      = real SMS through Twilio (required when NODE_ENV=production)
OTP_MODE=development
OTP_TTL_MINUTES=5
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Roles ---
# 10-digit mobile numbers (comma separated). These accounts are promoted after a successful OTP login.
ADMIN_PHONES=
SUPERADMIN_PHONES=

# --- Moderation ---
# false = properties posted from the app wait for admin approval; true = they go live immediately
AUTO_APPROVE_POSTS=false

# --- Search filters ---
# Minutes between refreshes of each listing's normalised filterFields (0 = off). The collection is
# shared with the website/scraper, so the API re-syncs on start-up and then on this interval.
FILTER_SYNC_MINUTES=10
