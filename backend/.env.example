# Copy this file to backend/.env and fill in real values. NEVER commit backend/.env.

# --- Database (the ONLY place the MongoDB connection string lives) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/comparedb?retryWrites=true&w=majority
MONGODB_COLLECTION=properties
# Optional: non-SRV (mongodb://host1,host2,...) string for the SAME cluster, used only when
# your network's DNS cannot resolve mongodb+srv records. Leave empty if you don't need it.
MONGODB_FALLBACK_URI=

# --- Server ---
PORT=5000
# development | test | production. Only "development" and "test" allow development OTPs, open
# CORS and the detailed /api/health. A MISSING or misspelt value is treated like production.
NODE_ENV=development
# Reverse proxies in front of the API, used to read the client IP for rate limiting:
#   1 (default) = one proxy (Render, Railway, Heroku, Nginx) | 0 or false = exposed directly
#   or a comma-separated list of trusted addresses/subnets, e.g. loopback,10.0.0.0/8
# Setting it higher than the real number of proxies lets clients spoof their IP and dodge limits.
TRUST_PROXY=1
# Random string, 24+ chars (required). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d
# Public https origin used in uploaded image URLs, e.g. https://api.example.com (recommended in production).
PUBLIC_URL=
# Comma-separated origins allowed for browser clients (the mobile app does not need this).
# Development: empty = allow all. Production: empty = no CORS headers at all (browsers blocked).
CORS_ORIGINS=

# --- OTP ---
# development = the OTP is returned to the app as devOtp (never logged) - only allowed when
#               NODE_ENV is development or test. ADMIN_PHONES are never promoted in this mode.
# twilio      = real SMS through Twilio. Required everywhere else (start-up refuses otherwise);
#               the default when OTP_MODE is empty and NODE_ENV is not development/test.
OTP_MODE=development
OTP_TTL_MINUTES=5
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
# Anti SMS-pumping: total OTP SMS the whole server may send per hour (all IPs and numbers).
OTP_GLOBAL_HOURLY_LIMIT=300
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Roles ---
# 10-digit mobile numbers (comma separated). Promoted after a successful SMS (OTP_MODE=twilio)
# login; never with development OTPs.
ADMIN_PHONES=
SUPERADMIN_PHONES=

# --- Search filters ---
# Minutes between refreshes of each listing's normalised filterFields (0 = off). The collection is
# shared with the website/scraper, so the API re-syncs on start-up and then on this interval.
FILTER_SYNC_MINUTES=10

# --- Firebase (customer sign-in for the /api/v2 mobile endpoints) ---
# Project id from Firebase console > Project settings > General. Required for /api/v2 customer routes.
FIREBASE_PROJECT_ID=
# The service-account JSON (Project settings > Service accounts > Generate new private key) pasted
# on ONE line. REQUIRED for /api/v2: ID tokens are checked for revocation, which needs admin
# credentials (or GOOGLE_APPLICATION_CREDENTIALS pointing at the key file).
FIREBASE_SERVICE_ACCOUNT=
